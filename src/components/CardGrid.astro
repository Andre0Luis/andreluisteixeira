---
import SectionHead from './SectionHead.astro';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  items: { title: string; text: string; note?: string; tags?: string[] }[];
  numbered?: boolean;
  tone?: 'base' | 'raised';
}

const { id, eyebrow, title, items, numbered = true, tone = 'base' } = Astro.props;
---

<section id={id} class:list={['border-t border-line py-20', tone === 'raised' && 'bg-surface/40']}>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={eyebrow} title={title} />
    <div class="grid gap-5 md:grid-cols-3">
      {
        items.map((item, i) => (
          <article class="card reveal flex flex-col" style={`--d: ${i * 90}ms`}>
            {numbered && <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>}
            <h3 class:list={['text-lg font-semibold tracking-tight', numbered && 'mt-3']}>{item.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
            {item.tags && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {item.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            )}
            {item.note && (
              <div class="mt-auto pt-5">
                <p class="border-l-2 border-accent/60 pl-3 font-mono text-xs leading-relaxed text-muted">{item.note}</p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
