---
import SectionHead from './SectionHead.astro';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  items: { title: string; text: string }[];
  numbered?: boolean;
  tone?: 'base' | 'raised';
}

const { id, eyebrow, title, items, numbered = true, tone = 'base' } = Astro.props;
---

<section id={id} class:list={['border-t border-line py-20', tone === 'raised' && 'bg-surface/40']}>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={eyebrow} title={title} />
    <div class="grid gap-5 md:grid-cols-3">
      {
        items.map((item, i) => (
          <article class="card flex flex-col">
            {numbered && <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>}
            <h3 class:list={['text-lg font-semibold tracking-tight', numbered && 'mt-3']}>{item.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
