---
import { useTranslations, type Locale } from '../i18n';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { education } = useTranslations(locale);
---

<section id="education" class="border-t border-line py-20">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={education.eyebrow} title={education.title} lead={education.lead} />

    <div class="grid gap-5 md:grid-cols-3">
      {
        education.items.map((item, i) => (
          <article class="card reveal" style={`--d: ${i * 80}ms`}>
            <p class="font-mono text-sm text-accent">{item.institution}</p>
            <p class="mt-1 font-mono text-xs text-muted">{item.period}</p>
            <h3 class="mt-3 text-lg font-semibold tracking-tight">{item.degree}</h3>
            <p class="mt-3 text-muted">{item.focus}</p>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-5 grid gap-5 md:grid-cols-[minmax(0,22rem)_1fr]">
      <div class="shine flex items-center gap-4 rounded-xl border border-line bg-surface p-5" data-spot>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-10 shrink-0 text-fg" fill="currentColor">
          <path
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
        <div>
          <p class="eyebrow">{education.certLabel}</p>
          <p class="mt-1 text-lg font-semibold tracking-tight">{education.certName}</p>
          <p class="mt-1 text-xs text-muted">{education.certNote}</p>
        </div>
      </div>

      <div class="rounded-xl border border-line bg-surface p-5">
        <p class="eyebrow">{education.learningTitle}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {education.learning.map((l) => <li class="chip">{l}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
