---
import { useTranslations, type Locale } from '../i18n';
import { extras } from '../i18n/content/extras';
import SectionHead from './SectionHead.astro';
import Pipeline from './vue/Pipeline.vue';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { engineering } = useTranslations(locale);
const { pipeline } = extras[locale];
const dg = {
  pt: { agent: 'Agente', act: 'Ação' },
  en: { agent: 'Agent', act: 'Action' },
  es: { agent: 'Agente', act: 'Acción' },
}[locale];
---

<section id="engineering" class="border-t border-line bg-surface/40 py-20">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={engineering.eyebrow} title={engineering.title} />

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-6">
      {
        engineering.pillars.map((item, i) => (
          <article
            class:list={['card reveal flex flex-col', i >= 2 && i < 5 ? 'lg:col-span-2' : 'lg:col-span-3']}
            style={`--d: ${i * 90}ms`}
          >
            <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.text}</p>

            {i === 5 && (
              <svg viewBox="0 0 360 120" class="mt-5 w-full" fill="none" aria-hidden="true">
                <g stroke="#3a414d" stroke-width="1.4">
                  <path d="M52 60h58" />
                  <path d="M150 60l60-34M150 60h60M150 60l60 34" />
                  <path d="M250 26l60 34M250 60h60M250 94l60-34" />
                </g>
                <g class="flow" stroke="#9bb8d3" stroke-width="2" stroke-linecap="round">
                  <path d="M52 60h58" />
                  <path d="M150 60l60-34" />
                  <path d="M150 60h60" />
                  <path d="M150 60l60 34" />
                  <path d="M250 26l60 34" />
                  <path d="M250 60h60" />
                  <path d="M250 94l60-34" />
                </g>
                <g fill="#14171c" stroke="#3a414d" stroke-width="1.6">
                  <rect x="12" y="44" width="40" height="32" rx="6" />
                  <rect x="110" y="44" width="40" height="32" rx="6" />
                  <rect x="210" y="10" width="40" height="32" rx="6" />
                  <rect x="210" y="44" width="40" height="32" rx="6" />
                  <rect x="210" y="78" width="40" height="32" rx="6" />
                  <rect x="310" y="44" width="40" height="32" rx="6" />
                </g>
              </svg>
            )}

            {i === 6 && (
              <svg viewBox="0 0 360 120" class="mt-5 w-full" fill="none" aria-hidden="true">
                <rect x="14" y="40" width="64" height="40" rx="8" fill="#14171c" stroke="#3a414d" stroke-width="1.6" />
                <rect x="148" y="12" width="64" height="40" rx="8" fill="#14171c" stroke="#3a414d" stroke-width="1.6" />
                <rect x="148" y="68" width="64" height="40" rx="8" fill="#14171c" stroke="#3a414d" stroke-width="1.6" />
                <rect x="282" y="40" width="64" height="40" rx="8" fill="#14171c" stroke="#3a414d" stroke-width="1.6" />
                <g stroke="#3a414d" stroke-width="1.4">
                  <path d="M78 60l70-32M78 60l70 32M212 32l70 28M212 88l70-28" />
                </g>
                <g class="flow" stroke="#9bb8d3" stroke-width="2" stroke-linecap="round">
                  <path d="M78 60l70-32" />
                  <path d="M78 60l70 32" />
                  <path d="M212 32l70 28" />
                  <path d="M212 88l70-28" />
                </g>
                <g class="font-mono" font-size="11" fill="#9aa3af" text-anchor="middle">
                  <text x="46" y="64">LLM</text>
                  <text x="180" y="36">MCP</text>
                  <text x="180" y="92">{dg.agent}</text>
                  <text x="314" y="64">{dg.act}</text>
                </g>
              </svg>
            )}

            <ul class="mt-5 flex flex-wrap gap-2">
              {item.tags?.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-20">
      <SectionHead eyebrow={pipeline.eyebrow} title={pipeline.title} lead={pipeline.lead} />
      <Pipeline client:visible t={pipeline} />
    </div>
  </div>
</section>
