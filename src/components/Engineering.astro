---
import { useTranslations, type Locale } from '../i18n';
import { extras } from '../i18n/content/extras';
import SectionHead from './SectionHead.astro';
import Pipeline from './vue/Pipeline.vue';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { engineering } = useTranslations(locale);
const { pipeline } = extras[locale];
---

<section id="engineering" class="border-t border-line bg-surface/40 py-20">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={engineering.eyebrow} title={engineering.title} />

    <div class="grid gap-5 md:grid-cols-3">
      {
        engineering.pillars.map((item, i) => (
          <article class="card reveal flex flex-col" style={`--d: ${i * 90}ms`}>
            <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {item.tags?.map((tag) => <li class="chip">{tag}</li>)}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-20">
      <SectionHead eyebrow={pipeline.eyebrow} title={pipeline.title} lead={pipeline.lead} />
      <Pipeline client:visible t={pipeline} />
    </div>
  </div>
</section>
