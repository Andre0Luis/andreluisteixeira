---
import { useTranslations, type Locale } from '../i18n';
import { pageUrl } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="border-t border-line py-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs text-muted">{t.footer}</p>
    <nav class="flex gap-5 font-mono text-xs">
      <a href={pageUrl(locale, 'home')} class="text-muted hover:text-fg">{t.nav.home}</a>
      <a href={pageUrl(locale, 'mountains')} class="text-muted hover:text-fg">{t.nav.mountains}</a>
      <a href={pageUrl(locale, 'coffee')} class="text-muted hover:text-fg">{t.nav.coffee}</a>
    </nav>
  </div>
</footer>
