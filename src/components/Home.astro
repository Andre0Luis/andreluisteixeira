---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import CardGrid from './CardGrid.astro';
import SectionHead from './SectionHead.astro';
import Education from './Education.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Projects from './Projects.vue';
import OutsideTabs from './OutsideTabs.vue';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-fg focus:px-4 focus:py-2 focus:text-bg"
  >
    {t.a11y.skip}
  </a>
  <Header locale={locale} />

  <main id="main">
    <Hero locale={locale} />

    <CardGrid
      id="principles"
      eyebrow={t.principles.eyebrow}
      title={t.principles.title}
      items={t.principles.cards}
      tone="raised"
    />

    <CardGrid id="journey" eyebrow={t.journey.eyebrow} title={t.journey.title} items={t.journey.blocks} numbered={false} />

    <CardGrid
      id="engineering"
      eyebrow={t.engineering.eyebrow}
      title={t.engineering.title}
      items={t.engineering.pillars}
      tone="raised"
    />

    <section id="projects" class="border-t border-line py-20">
      <div class="mx-auto max-w-6xl px-5">
        <SectionHead eyebrow={t.projects.eyebrow} title={t.projects.title} />
        <Projects client:visible items={t.projects.items} label={t.projects.selectLabel} />
      </div>
    </section>

    <Education locale={locale} />

    <section id="outside" class="border-t border-line bg-surface/40 py-20">
      <div class="mx-auto max-w-6xl px-5">
        <SectionHead eyebrow={t.outside.eyebrow} title={t.outside.title} />
        <OutsideTabs client:visible tabs={t.outside.tabs} label={t.outside.tabsLabel} />
      </div>
    </section>

    <Contact locale={locale} />
  </main>

  <Footer locale={locale} />
</Base>
