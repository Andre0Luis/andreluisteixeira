---
import { useTranslations, type Locale } from '../i18n';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { journey } = useTranslations(locale);
---

<section id="journey" class="border-t border-line py-20">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={journey.eyebrow} title={journey.title} />

    <div class="grid gap-14 lg:grid-cols-[1fr_minmax(0,26rem)]">
      <div class="space-y-9">
        {
          journey.blocks.map((b, i) => (
            <article class="reveal border-l-2 border-line pl-6 transition-colors hover:border-accent" style={`--d: ${i * 80}ms`}>
              <h3 class="text-xl font-semibold tracking-tight">{b.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{b.text}</p>
            </article>
          ))
        }
      </div>

      <div>
        <h3 class="eyebrow mb-6">{journey.timelineTitle}</h3>
        <ol class="relative pl-7" data-timeline>
          <span class="absolute left-0 top-0 h-full w-px bg-line" aria-hidden="true"></span>
          <span class="tl-line" aria-hidden="true"></span>
          {
            journey.timeline.map((m, i) => (
              <li class="relative pb-7 last:pb-0" data-tl-item>
                <span
                  class:list={[
                    'tl-dot absolute top-1.5 -left-[34px] size-3 rounded-full border-2 border-bg',
                    i === journey.timeline.length - 1 && 'last-dot',
                  ]}
                  aria-hidden="true"
                />
                <div class="tl-body">
                  <p class="font-mono text-xs text-accent">{m.when}</p>
                  <p class="mt-1 font-medium">{m.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{m.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
