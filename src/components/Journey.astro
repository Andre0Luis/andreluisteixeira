---
import { useTranslations, type Locale } from '../i18n';
import SectionHead from './SectionHead.astro';
import Path from './vue/Path.vue';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { journey } = useTranslations(locale);
---

<section id="journey" class="border-t border-line py-20">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={journey.eyebrow} title={journey.title} />
    <Path
      client:visible
      steps={journey.steps}
      stepLabel={journey.stepLabel}
      tookLabel={journey.tookLabel}
      prev={journey.prev}
      next={journey.next}
    />
  </div>
</section>
