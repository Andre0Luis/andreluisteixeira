---
import { type Locale } from '../i18n';
import { extras } from '../i18n/content/extras';
import { pageUrl } from '../i18n/routes';
import SectionHead from './SectionHead.astro';
import CupArt from './art/CupArt.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { outside } = extras[locale];
---

<section id="outside" class="border-t border-line bg-surface/40 py-20">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={outside.eyebrow} title={outside.title} lead={outside.lead} />

    <div class="grid gap-5 md:grid-cols-2">
      <a href={pageUrl(locale, 'mountains')} class="card reveal group block overflow-hidden p-0">
        <div class="relative h-48 overflow-hidden border-b border-line bg-gradient-to-b from-[#161c26] to-surface">
          <svg viewBox="0 0 400 190" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <circle cx="312" cy="44" r="14" fill="#cfd8e3" opacity="0.85" />
            <g fill="#cfd8e3">
              <circle cx="40" cy="30" r="1.2" opacity="0.7" />
              <circle cx="96" cy="58" r="1" opacity="0.5" />
              <circle cx="168" cy="26" r="1.3" opacity="0.7" />
              <circle cx="236" cy="52" r="1" opacity="0.5" />
              <circle cx="372" cy="90" r="1" opacity="0.5" />
            </g>
            <path class="m-back" d="M0 125 70 70 120 108 182 38 244 98 300 62 362 104 400 80V190H0Z" fill="#202733" />
            <path class="m-mid" d="M0 156 74 104 134 140 206 88 266 134 336 98 400 144V190H0Z" fill="#171c25" />
            <path class="m-front" d="M0 178 92 140 172 166 262 130 342 164 400 146V190H0Z" fill="#0f1216" />
          </svg>
        </div>
        <div class="p-6">
          <p class="eyebrow">{outside.mountains.kicker}</p>
          <h3 class="mt-2 text-2xl font-semibold tracking-tight">{outside.mountains.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{outside.mountains.text}</p>
          <div class="mt-5 flex items-center justify-between gap-3">
            <span class="chip">{outside.mountains.stat}</span>
            <span class="inline-flex items-center gap-2 text-sm text-fg">
              {outside.mountains.cta}
              <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </div>
      </a>

      <a href={pageUrl(locale, 'coffee')} class="card reveal group block overflow-hidden p-0" style="--d: 100ms">
        <div class="relative grid h-48 place-items-center overflow-hidden border-b border-line bg-gradient-to-b from-[#1d1814] to-surface">
          <CupArt class="h-40 w-auto transition-transform duration-500 group-hover:scale-105" />
        </div>
        <div class="p-6">
          <p class="eyebrow">{outside.coffee.kicker}</p>
          <h3 class="mt-2 text-2xl font-semibold tracking-tight">{outside.coffee.title}</h3>
          <p class="mt-3 leading-relaxed text-muted">{outside.coffee.text}</p>
          <div class="mt-5 flex items-center justify-between gap-3">
            <span class="chip">{outside.coffee.stat}</span>
            <span class="inline-flex items-center gap-2 text-sm text-fg">
              {outside.coffee.cta}
              <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </div>
      </a>
    </div>

    <h3 class="eyebrow mb-5 mt-14">{outside.moreTitle}</h3>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        outside.items.map((item, i) => (
          <li class="card reveal" style={`--d: ${i * 70}ms`}>
            <p class="font-medium">{item.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .m-back,
  .m-mid,
  .m-front {
    transition: transform 0.6s ease;
  }
  a:hover .m-back {
    transform: translateX(-8px);
  }
  a:hover .m-mid {
    transform: translateX(6px);
  }
  a:hover .m-front {
    transform: translateX(-10px);
  }
  @media (prefers-reduced-motion: reduce) {
    .m-back,
    .m-mid,
    .m-front {
      transition: none;
    }
  }
</style>
