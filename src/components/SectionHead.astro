---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="mb-10 max-w-2xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-lg text-muted">{lead}</p>}
</div>
