---
import { useTranslations, type Locale } from '../i18n';
import { extras } from '../i18n/content/extras';
import SectionHead from './SectionHead.astro';
import StackExplorer from './vue/StackExplorer.vue';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { stack, projects } = t;
const ex = extras[locale];
---

<section id="stack" class="border-t border-line py-20">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHead eyebrow={stack.eyebrow} title={stack.title} lead={stack.lead} />
    <StackExplorer
      client:visible
      groups={stack.groups}
      projects={projects.items.map((p) => ({ name: p.name, tags: p.tags }))}
      t={ex.stackExplorer}
    />
  </div>
</section>
