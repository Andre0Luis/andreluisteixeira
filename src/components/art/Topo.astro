---
// Curvas de nível geradas por código: leves, sem imagem, e giram devagar.
interface Props {
  rings?: number;
  seed?: number;
  class?: string;
}

const { rings = 15, seed = 0, class: cls = '' } = Astro.props;
const N = 96;

function ring(i: number) {
  const r = 36 + i * 25;
  const pts: string[] = [];
  for (let k = 0; k < N; k++) {
    const a = (k / N) * Math.PI * 2;
    const n =
      1 +
      0.09 * Math.sin(3 * a + seed + i * 0.22) +
      0.055 * Math.sin(5 * a + seed * 1.7 + i * 0.31) +
      0.035 * Math.sin(2 * a - seed + i * 0.12);
    pts.push(`${(Math.cos(a) * r * n).toFixed(1)},${(Math.sin(a) * r * n * 0.88).toFixed(1)}`);
  }
  return `M${pts.join('L')}Z`;
}

const paths = Array.from({ length: rings }, (_, i) => ({ d: ring(i), strong: i % 4 === 0 }));
---

<svg viewBox="-420 -420 840 840" class={cls} aria-hidden="true" fill="none">
  <g class="topo">
    {paths.map((p) => <path d={p.d} stroke="currentColor" stroke-width={p.strong ? 1.4 : 0.7} opacity={p.strong ? 0.5 : 0.28} />)}
  </g>
</svg>
