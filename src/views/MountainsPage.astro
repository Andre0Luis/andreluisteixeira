---
import { Image } from 'astro:assets';
import trail from '../assets/trail.jpg';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import Altimeter from '../components/Altimeter.astro';
import Ridges from '../components/art/Ridges.astro';
import Lessons from '../components/vue/Lessons.vue';
import { useTranslations, type Locale } from '../i18n';
import { mountains } from '../i18n/content/mountains';
import { extras } from '../i18n/content/extras';
import { pageUrl } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const m = mountains[locale];
const ex = extras[locale];
---

<Base locale={locale} page="mountains" title={m.meta.title} description={m.meta.description}>
  <Header locale={locale} page="mountains" />
  <Altimeter label={m.altimeter.label} unit={m.altimeter.unit} max={2810} htmlLang={t.htmlLang} />

  <main id="main">
    <!-- Abertura -->
    <section class="relative isolate overflow-hidden border-b border-line">
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[#090b0f] via-[#10141b] to-bg"></div>
      <Ridges class="absolute inset-0 -z-10" />

      <div class="mx-auto flex min-h-[calc(100svh-3.5rem)] max-w-6xl flex-col justify-between px-5 pb-10 pt-16 sm:pt-24">
        <div class="reveal max-w-3xl">
          <p class="eyebrow">{m.hero.eyebrow}</p>
          <h1 class="mt-4 text-6xl font-semibold tracking-tight sm:text-8xl">{m.hero.title}</h1>
          <p class="mt-6 font-mono text-lg text-accent sm:text-xl">&ldquo;{m.hero.quote}&rdquo;</p>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{m.hero.lead}</p>
        </div>

        <div class="mt-16">
          <dl class="reveal grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-4" style="--d: 150ms">
            {
              m.stats.map((s) => (
                <div class="flex flex-col bg-surface/95 px-5 py-5 backdrop-blur" data-spot>
                  <dd
                    class="font-mono text-3xl font-semibold tracking-tight"
                    {...(s.fixed
                      ? {}
                      : {
                          'data-count-to': s.to,
                          'data-suffix': s.suffix ?? '',
                          'data-locale': t.htmlLang,
                        })}
                  >
                    {(s.fixed ? String(s.to) : s.to.toLocaleString(t.htmlLang)) + (s.suffix ?? '')}
                  </dd>
                  <dt class="mt-1 text-sm text-muted">{s.label}</dt>
                </div>
              ))
            }
          </dl>
          <p class="mt-6 flex items-center gap-2 font-mono text-xs text-muted">
            <span class="inline-block animate-bounce" aria-hidden="true">&darr;</span>
            {m.hero.scroll}
          </p>
        </div>
      </div>
    </section>

    <!-- O que a montanha cobra -->
    <section class="py-20">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal mb-10 max-w-2xl">
          <p class="eyebrow">{m.lessons.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{m.lessons.title}</h2>
        </div>
        <Lessons client:visible items={m.lessons.items} hint={m.lessons.hint} />
      </div>
    </section>

    <!-- Capítulo 1: Roraima -->
    <section class="relative overflow-hidden border-y border-line bg-surface/40 py-24">
      <p
        class="pointer-events-none absolute -right-4 top-6 select-none font-mono text-[9rem] font-bold leading-none tracking-tighter text-fg/[0.035] sm:text-[16rem]"
        data-speed="-0.06"
        style="transform: translate3d(0, var(--py, 0px), 0)"
        aria-hidden="true"
      >
        2.810
      </p>
      <div class="relative mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1.4fr_1fr]">
        <div class="reveal">
          <p class="eyebrow">{m.roraima.eyebrow}</p>
          <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl">{m.roraima.title}</h2>
          <ul class="mt-6 flex flex-wrap gap-2">
            {m.roraima.meta.map((x) => <li class="chip">{x}</li>)}
          </ul>
          <div class="mt-8 space-y-5 text-xl leading-relaxed">
            {
              m.roraima.paragraphs.map((p, i) => (
                <p class:list={[i === 0 ? 'text-fg' : 'text-muted']}>{p}</p>
              ))
            }
          </div>
        </div>

        <aside class="reveal self-end" style="--d: 120ms">
          <div class="card">
            <p class="eyebrow">{m.roraima.factLabel}</p>
            <p class="mt-3 leading-relaxed">{m.roraima.fact}</p>
          </div>
        </aside>
      </div>
    </section>

    <!-- Ponto de virada + foto -->
    <section class="py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-2">
        <div class="reveal order-2 lg:order-1">
          <p class="eyebrow">{m.turning.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{m.turning.title}</h2>
          <p class="mt-6 border-l-2 border-accent/60 pl-5 text-lg leading-relaxed text-muted">{m.turning.text}</p>
          <p class="mt-6 font-mono text-accent">{m.turning.closing}</p>
        </div>
        <figure class="reveal order-1 lg:order-2" style="--d: 100ms">
          <div data-tilt="5">
            <Image
              src={trail}
              alt={m.photo.alt}
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 1024px) 560px, 100vw"
              class="w-full rounded-2xl border border-line object-cover"
            />
          </div>
          <figcaption class="mt-3 font-mono text-xs text-muted">{m.photo.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- Da trilha para o código -->
    <section class="border-t border-line bg-surface/40 py-20">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal mb-10 max-w-2xl">
          <p class="eyebrow">{m.bridge.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{m.bridge.title}</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {
            m.bridge.items.map((it, i) => (
              <article class="card reveal flex flex-col" style={`--d: ${i * 90}ms`}>
                <h3 class="text-lg font-semibold tracking-tight">{it.title}</h3>
                <p class="mt-3 leading-relaxed text-muted">{it.text}</p>
                {i === 2 && (
                  <a
                    href={pageUrl(locale, 'home', 'projects')}
                    class="mt-auto pt-5 font-mono text-sm text-accent underline-offset-4 hover:underline"
                  >
                    {m.bridge.flipLink} <span aria-hidden="true">&rarr;</span>
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Convite -->
    <section class="border-t border-line py-20">
      <div class="reveal mx-auto max-w-3xl px-5 text-center">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{m.cta.title}</h2>
        <p class="mt-4 text-lg text-muted">{m.cta.text}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="#contact" class="btn btn-solid">{ex.ui.contactCta}</a>
          <a href={pageUrl(locale, 'coffee')} class="btn btn-outline">{m.cta.coffee} <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>

    <Contact locale={locale} />
  </main>

  <Footer locale={locale} />
</Base>
